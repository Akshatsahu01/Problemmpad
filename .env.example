MONGO_URI=mongodb://127.0.0.1:27017/codevault
GOOGLE_API_KEY=your_gemini_api_key
JWT_SECRET=replace_with_a_long_random_secret
PORT=4000
# Temporarily allow any frontend origin; set to your deployed frontend URL later. Multiple origins may be comma-separated.
CLIENT_ORIGIN=*
# Optional ordered model list. If omitted, the backend uses 3.5 Flash-Lite then 3.8 Flash.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
# Legacy single-model preference is still supported and followed by current fallbacks.
# GEMINI_MODEL=gemini-3.5-flash-lite
ONLINECOMPILER_API_KEY=your_onlinecompiler_api_key
# Optional; defaults to OnlineCompiler.io's Judge0-compatible endpoint.
# ONLINECOMPILER_API_URL=https://api.onlinecompiler.io/api/judge0
